rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShareCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9\\-]+$');
    }

    // 3. Validation Blueprints
    function isValidUserVault(data) {
      return data.keys().hasAll([
          'ownerId',
          'publisherName',
          'visits',
          'timeEntries',
          'monthlyStats',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'publisherName',
          'visits',
          'timeEntries',
          'monthlyStats',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.publisherName is string
        && data.publisherName.size() >= 1
        && data.publisherName.size() <= 120
        && data.visits is list
        && data.visits.size() <= 500
        && (data.visits.size() == 0 || data.visits[0] is map)
        && data.timeEntries is list
        && data.timeEntries.size() <= 1000
        && (data.timeEntries.size() == 0 || data.timeEntries[0] is map)
        && data.monthlyStats is list
        && data.monthlyStats.size() <= 120
        && (data.monthlyStats.size() == 0 || data.monthlyStats[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartnerShare(data, shareCode) {
      return data.keys().hasAll([
          'shareCode',
          'ownerId',
          'ownerName',
          'sharedVisits',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'shareCode',
          'ownerId',
          'ownerName',
          'sharedVisits',
          'createdAt',
          'updatedAt'
        ])
        && data.shareCode is string
        && data.shareCode.size() >= 6
        && data.shareCode.size() <= 16
        && data.shareCode == shareCode
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.ownerName is string
        && data.ownerName.size() >= 1
        && data.ownerName.size() <= 120
        && data.sharedVisits is list
        && data.sharedVisits.size() <= 500
        && (data.sharedVisits.size() == 0 || data.sharedVisits[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection: /userVaults/{userId} (Strictly Private Owner Vault)
    match /userVaults/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserVault(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserVault(incoming())
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'publisherName',
          'visits',
          'timeEntries',
          'monthlyStats',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid;
    }

    // 5. Collection: /partnerShares/{shareCode} (Shared Schedule & Pins by Code)
    match /partnerShares/{shareCode} {
      // Authenticated verified users who know the exact shareCode can fetch it via get (list is disabled to prevent scraping)
      allow get: if isVerifiedUser() && isValidShareCode(shareCode);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidShareCode(shareCode)
        && isValidPartnerShare(incoming(), shareCode)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidShareCode(shareCode)
        && isValidPartnerShare(incoming(), shareCode)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().shareCode == existing().shareCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerName',
          'sharedVisits',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidShareCode(shareCode)
        && existing().ownerId == request.auth.uid;
    }
  }
}
